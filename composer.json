		"tecnickcom/tcpdf": "^6.2",
		"fightbulc/moment": "^1.30",
		"kub-at/php-simple-html-dom-parser": "^1.9",
		"kwn/number-to-words": "^1.8",
        "setasign/fpdi": "2.5",
		"calcinai/php-imagick": "^0.1.2",
		"mailgun/mailgun-php": "^3.2",
		"kriswallsmith/buzz": "^1.2",
		"nyholm/psr7": "^1.3",
